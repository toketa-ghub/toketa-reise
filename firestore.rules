// Diese Regeln sind in der Firebase-Konsole veröffentlicht (Firestore → Regeln).
// Nur das eigene Konto darf unter users/<UID> lesen und schreiben, alles andere ist gesperrt.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/XFjnQCM7JCOh4GaKCWN09UTgxOF3/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == 'XFjnQCM7JCOh4GaKCWN09UTgxOF3';
    }
  }
}
